{
  "name": "dsh-ainvestor",
  "version": "0.1.0",
  "description": "AiInvestor analysis copilot for DeepSeek Harness: A-share Chan theory, composite scoring, financials, and local investment knowledge base as agent tools",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOirBRight/dsh-ainvestor.git"
  },
  "homepage": "https://github.com/NOirBRight/dsh-ainvestor#readme",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "node scripts/verify-pack.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cosmokit": "1.8.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-util-crypto": "0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
